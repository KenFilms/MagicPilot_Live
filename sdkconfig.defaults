CONFIG_IDF_TARGET="esp32p4"

# M5Stack Tab5: ESP32-P4 (rev < 3.0), 16 MB flash, 32 MB PSRAM @ 200 MHz
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Display: three DPI frame buffers (triple buffering) so rendering never waits for VSYNC
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3

# USB host (USB-A port = ESP32-P4 High-Speed OTG)
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_UVC_INTERVAL_ARRAY_SIZE=8

# Panel refresh 60 Hz (patched BSP): a 30 fps source is shown at exactly 2 refreshes per frame
CONFIG_BSP_LCD_REFRESH_HZ=60

# Bluetooth LE to the camera. The ESP32-P4 has no radio: the controller runs on the Tab5's
# ESP32-C6 (ESP-Hosted over SDIO), the P4 runs the Bluedroid host stack.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
# The C6 reset line (GPIO 15) is high while the C6 runs. ESP-Hosted's Tab5 profile defaults to
# active-low, which keeps the C6 in reset on this board (SDIO send_op_cond 0x107).
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_ENABLE_BT_BLUEDROID=y
CONFIG_ESP_HOSTED_BLUEDROID_HCI_VHCI=y
# Bluetooth needs little throughput: keep ESP-Hosted's buffers and task stacks out of internal RAM,
# which the video band buffers need. A failing C6 link must not reboot the monitor.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=8
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=8
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
